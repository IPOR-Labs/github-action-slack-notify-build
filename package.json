{
  "name": "github-action-slack-notify-build",
  "version": "1.0.0",
  "description": "Report GitHub Actions build status on Slack",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "ncc build index.js --license licenses.txt",
    "test": "node --test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@slack/web-api": "^8.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
